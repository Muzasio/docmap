# Python
__pycache__/
*.pyc

# tree-sitter parsers (rebuilt with: python3 docmap.py setup --install parsers)
.deps/

# Generated by docmap when it scans a project (contain local paths and your edits)
docs/viewer/
tests/fixtures/*/docs/viewer/

# Local settings and secrets, never uploaded
.env
settings.json
*.local.json
